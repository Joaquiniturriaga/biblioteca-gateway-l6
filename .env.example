# biblioteca-gateway-l6 (repo de partida de L6, fin de L4)
#
# Este .env va en la RAIZ del repo (junto a sembrar.mts). Copialo a .env y
# rellenalo con TUS valores. sembrar.mts los lee con --env-file.
#
# GOOGLE_BOOKS_API_KEY y GROQ_API_KEY: L4 tramos 2.3 y 2.4. Si no las tienes,
# corre `node --env-file=.env sembrar.mts --respaldo`: ese modo no las necesita.
GOOGLE_BOOKS_API_KEY=
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-20b
CONSULTA=ciencia ficcion

# El sub (no el correo) de tus dos usuarios de Cognito. L4 tramo 2.5: lo sacas
# del claim "sub" del payload de tu access token, despues del canje del tramo 6
# de L3 (token.mjs lo imprime).
SUB_LECTOR=
SUB_INVITADO=
