# gateway/.env — copialo a gateway/.env y rellenalo con TU ficha.
#
# COGNITO_ISSUER y COGNITO_CLIENT_ID: L3 tramo 7.1. Salen de tu ficha.txt
# (ISSUER del tramo 1.4, CLIENT_ID del tramo 1.3b). No son secretos, pero
# tienen que ser los de TU user pool.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=

# BFF_URL: L4 tramo 8.1. Apunta al biblioteca-bff que corres en tu computador.
BFF_URL=http://localhost:3000
